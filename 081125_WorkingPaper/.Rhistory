layout(
title = "MCA — Individuos por 'medio' (D1 - D3) — Hombres",
scene = list(
xaxis = list(title = ax1, zeroline = TRUE),
yaxis = list(title = ax2, zeroline = TRUE),
zaxis = list(title = ax3, zeroline = TRUE),
aspectmode = "data"
),
legend = list(orientation = "h", y = -0.1)
)
