# 3) Paleta
ncol_m <- nlevels(coords$medio)
pal    <- brewer.pal(max(3, min(8, ncol_m)), "Dark2")
# 2) % de varianza para títulos de ejes
eig <- res_mca$eig
ax1 <- paste0("Dim 1 (", round(eig[1,2], 1), "%)")
ax2 <- paste0("Dim 2 (", round(eig[2,2], 1), "%)")
ax3 <- paste0("Dim 3 (", round(eig[3,2], 1), "%)")
