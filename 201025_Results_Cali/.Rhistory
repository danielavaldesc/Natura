library(dplyr)
library(ggplot2)
library(forcats)
library(stringr)
# -------------------------
# Parámetros generales
# -------------------------
ciudades   <- c("Bogota", "Cali", "Medellin")
N_grupos   <- 8
N_alim     <- 5
seed_foods <- 123  # para que el muestreo aleatorio sea reproducible
set.seed(seed_foods)
# Directorio de salida (ajústalo)
panel_dir <- "paneles_heatmap"
if (!dir.exists(panel_dir)) dir.create(panel_dir, recursive = TRUE)
# -------------------------
# Utilidad: labels cortos (para que no se recorten)
# -------------------------
shorten_lbl <- function(x, width = 28) {
stringr::str_trunc(x, width = width, side = "right", ellipsis = "…")
}
# -------------------------
# Tema tipo "tabla" (asegura márgenes para textos largos)
# -------------------------
theme_table <- function() {
theme_minimal(base_size = 10) +
theme(
panel.grid = element_blank(),
axis.title = element_blank(),
# Etiquetas del eje X arriba, como en la imagen
axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 0, size = 7),
axis.ticks.x = element_blank(),
# Nombres de alimentos a la izquierda
axis.text.y = element_text(size = 8, margin = margin(r = 6)),
# Mucho margen a la izquierda (alimentos) y a la derecha (grupos rotados)
plot.margin = margin(t = 10, r = 130, b = 10, l = 210),
# Leyenda compacta
legend.title = element_text(size = 10),
legend.text  = element_text(size = 9),
legend.key.height = unit(0.55, "cm"),
# Título
plot.title = element_text(face = "bold", size = 16, hjust = 0.5),
# Quita subtítulos/captions
plot.subtitle = element_blank(),
plot.caption  = element_blank()
)
}
# -------------------------
# Línea vertical anual + mensual de referencia (más “fechas de referencia”)
# -------------------------
# (Anual gruesa + semestral fina; puedes ajustar)
make_x_breaks <- function(x_levels) {
# x_levels es un vector ordenado de Year_Month
# asume formato "YYYY-MM" o similar (si no, ajusta parsing)
xm <- as.Date(paste0(x_levels, "-01"))
yrs <- unique(format(xm, "%Y"))
# anual (ene)
annual <- which(format(xm, "%m") == "01")
# semestral (jul)
semi <- which(format(xm, "%m") == "07")
list(annual = annual, semi = semi)
}
# -------------------------
# Función principal por ciudad
# -------------------------
plot_city_heatmaps <- function(ciudad_obj, dataset_ts, N_grupos, N_alim, panel_dir) {
# -------------------------
# Selección de 8 grupos (los primeros 8 que existan para esa ciudad)
# -------------------------
grupos_sel <- dataset_ts %>%
filter(Ciudad == ciudad_obj) %>%
distinct(Grupo) %>%
slice(1:N_grupos) %>%
pull(Grupo)
# -------------------------
# 5 alimentos ALEATORIOS por grupo (no por ranking)
# (si un grupo tiene <5 alimentos, toma los que haya)
# -------------------------
foods_random <- dataset_ts %>%
filter(Ciudad == ciudad_obj, Grupo %in% grupos_sel) %>%
distinct(Grupo, Alimento) %>%
group_by(Grupo) %>%
slice_sample(n = N_alim, replace = FALSE) %>%
ungroup()
# -------------------------
# Base para heatmap (solo esos alimentos)
# -------------------------
hm_data <- dataset_ts %>%
semi_join(foods_random, by = c("Grupo", "Alimento")) %>%
filter(Ciudad == ciudad_obj) %>%
mutate(
Year_Month = as.character(Year_Month),
Grupo      = as.character(Grupo),
Alimento   = as.character(Alimento)
)
# Orden del eje X (meses)
x_levels <- hm_data %>%
distinct(Year_Month) %>%
arrange(Year_Month) %>%
pull(Year_Month)
hm_data <- hm_data %>%
mutate(Year_Month = factor(Year_Month, levels = x_levels))
# Orden del eje Y: por grupo y luego alimentos (alimentos “en bloque” dentro del grupo)
# OJO: el usuario pidió NO “en orden” (no ranking); pero sí conviene agruparlos.
# Aquí mantenemos el orden aleatorio resultante del muestreo (por grupo).
foods_order <- foods_random %>%
mutate(
Grupo = as.character(Grupo),
Alimento = as.character(Alimento)
) %>%
group_by(Grupo) %>%
mutate(ord = row_number()) %>%
ungroup()
hm_data <- hm_data %>%
left_join(foods_order, by = c("Grupo", "Alimento")) %>%
mutate(
# etiqueta izquierda: alimento (corto para que no invada la grilla)
Alimento_short = shorten_lbl(Alimento, width = 34),
# factor Y: Grupo + Alimento (manteniendo ord)
y_id = paste0(Grupo, "||", sprintf("%02d", ord), "||", Alimento_short)
)
y_levels <- hm_data %>%
distinct(Grupo, ord, Alimento_short, y_id) %>%
arrange(Grupo, ord) %>%
pull(y_id)
hm_data <- hm_data %>%
mutate(y_id = factor(y_id, levels = y_levels))
# -------------------------
# Posiciones para:
# - líneas divisorias horizontales por grupo (también sobre la zona “alimentos”)
# - etiquetas de grupo a la derecha (centro del bloque del grupo)
# -------------------------
y_map <- hm_data %>%
distinct(Grupo, ord, y_id) %>%
arrange(Grupo, ord) %>%
mutate(y_num = as.numeric(y_id))
group_centers <- y_map %>%
group_by(Grupo) %>%
summarise(
y_min = min(y_num),
y_max = max(y_num),
y_mid = (y_min + y_max) / 2,
.groups = "drop"
) %>%
mutate(
Grupo_short = shorten_lbl(Grupo, width = 30)  # evita recortes de nombres largos
)
# Líneas horizontales: al inicio de cada grupo (excepto el primero)
group_starts <- y_map %>%
group_by(Grupo) %>%
summarise(y_start = min(y_num), .groups = "drop") %>%
arrange(y_start) %>%
mutate(y_line = y_start - 0.5) %>%
slice(-1) %>%
pull(y_line)
# Líneas verticales de referencia (anual + semestral)
xb <- make_x_breaks(x_levels)
vlines_annual <- (xb$annual - 0.5)   # entre columnas
vlines_semi   <- (xb$semi   - 0.5)
# -------------------------
# 1) ESCALA CONTINUA (paleta oscura / contraste alto)
# -------------------------
p_cont <- ggplot(hm_data, aes(x = Year_Month, y = y_id, fill = Precio_kg_prom)) +
geom_tile(color = "white", linewidth = 0.15) +
# referencia vertical
geom_vline(xintercept = vlines_semi,   linewidth = 0.25, color = "black", alpha = 0.35) +
geom_vline(xintercept = vlines_annual, linewidth = 0.6,  color = "black", alpha = 0.75) +
# división por grupo (horizontal) — atraviesa TODO el panel (incluye “zona alimentos”)
geom_hline(yintercept = group_starts, linewidth = 0.9, color = "black") +
# paleta oscura y legible
scale_fill_viridis_c(option = "D", na.value = "grey25", name = "Precio/kg") +
# etiquetas Y (solo alimento)
scale_y_discrete(labels = function(z) sub("^.*\\|\\|\\d\\d\\|\\|", "", z)) +
coord_cartesian(clip = "off") +
# grupos a la derecha
geom_text(
data = group_centers,
aes(
x = Inf,
y = y_mid,
label = Grupo_short
),
inherit.aes = FALSE,
hjust = -0.05,
vjust = 0.5,
angle = -90,
size = 3.2,
fontface = "bold"
) +
labs(title = paste0("Matriz de precios mensuales – ", ciudad_obj)) +
theme_table()
ggsave(
filename = file.path(panel_dir, paste0("heatmap_", ciudad_obj, "_cont.png")),
plot = p_cont, width = 18, height = 10, dpi = 300
)
# -------------------------
# 2) ESCALA POR CUARTILES (sin “NA” en la leyenda)
#   - NA se queda como fill gris por na.value, pero NO aparece como categoría
# -------------------------
hm_quart <- hm_data %>%
mutate(
q = dplyr::ntile(Precio_kg_prom, 4),
q_lbl = dplyr::case_when(
is.na(Precio_kg_prom) ~ NA_character_,
q == 1 ~ "Q1 (bajo)",
q == 2 ~ "Q2",
q == 3 ~ "Q3",
q == 4 ~ "Q4 (alto)"
),
q_lbl = factor(q_lbl, levels = c("Q1 (bajo)", "Q2", "Q3", "Q4 (alto)"))
)
p_quart <- ggplot(hm_quart, aes(x = Year_Month, y = y_id, fill = q_lbl)) +
geom_tile(color = "white", linewidth = 0.15) +
geom_vline(xintercept = vlines_semi,   linewidth = 0.25, color = "black", alpha = 0.35) +
geom_vline(xintercept = vlines_annual, linewidth = 0.6,  color = "black", alpha = 0.75) +
geom_hline(yintercept = group_starts, linewidth = 0.9, color = "black") +
# Paleta discreta oscura (sin colores claros)
# NA: gris oscuro, pero sin item “NA” en leyenda (porque NA no es un nivel del factor)
scale_fill_manual(
values = c(
"Q1 (bajo)" = "#2b1055",
"Q2"        = "#6a1b9a",
"Q3"        = "#c2185b",
"Q4 (alto)" = "#f9a825"
),
na.value = "grey25",
drop = TRUE,
name = "Precio/kg (cuartiles)"
) +
scale_y_discrete(labels = function(z) sub("^.*\\|\\|\\d\\d\\|\\|", "", z)) +
coord_cartesian(clip = "off") +
geom_text(
data = group_centers,
aes(x = Inf, y = y_mid, label = Grupo_short),
inherit.aes = FALSE,
hjust = -0.05,
vjust = 0.5,
angle = -90,
size = 3.2,
fontface = "bold"
) +
labs(title = paste0("Matriz de precios mensuales – ", ciudad_obj)) +
theme_table()
ggsave(
filename = file.path(panel_dir, paste0("heatmap_", ciudad_obj, "_quart.png")),
plot = p_quart, width = 18, height = 10, dpi = 300
)
}
# ============================================================
# BUCLE: 3 ciudades, 2 salidas por ciudad
# ============================================================
for (ciudad_obj in ciudades) {
plot_city_heatmaps(
ciudad_obj = ciudad_obj,
dataset_ts = dataset_ts,
N_grupos   = N_grupos,
N_alim     = N_alim,
panel_dir  = panel_dir
)
}
